# MailAgent 环境变量配置
# 用法：cp .env.example .env，然后填入实际值。.env 已在 .gitignore 中忽略。
# 加载顺序：终端已设置的 env > .env 文件 > config.yml 默认值

# ============================================================
# LLM 模型配置（必填用于真实分类）
# ============================================================

# OpenAI-compatible API key（如 sk-...）
OPENAI_API_KEY=

# 模型 API 端点（OpenAI / DeepSeek / Qwen / long-cat 等 OpenAI 兼容服务）
MAILAGENT_MODEL__BASE_URL=https://api.openai.com/v1

# 模型名（如 gpt-4.1-mini / deepseek-chat / longcat-flash 等）
MAILAGENT_MODEL__MODEL_NAME=gpt-4.1-mini

# 是否启用 LLM（true 时 ClassifyAgent 调用真实 LLM，false 时回退到 keyword match）
MAILAGENT_MODEL__ENABLED=true

# ============================================================
# 数据库（默认 SQLite，可改为 PostgreSQL）
# ============================================================
MAILAGENT_DATABASE_URL=sqlite+aiosqlite:///./data/mailagent.db
# MAILAGENT_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mailagent

# ============================================================
# Redis（arq Worker 队列，本地开发可用 docker run -d -p 6379:6379 redis:7-alpine）
# ============================================================
# MAILAGENT_REDIS__URL=redis://localhost:6379/0

# ============================================================
# 分类反馈管理接口（默认关闭）
# 仅在可信反向代理会剥离外部同名 header，并注入已认证 reviewer ID 时启用。
# ============================================================
# MAILAGENT_CLASSIFICATION_FEEDBACK__MODE=trusted_internal
# MAILAGENT_CLASSIFICATION_FEEDBACK__REVIEWER_IDENTITY_HEADER=X-MailAgent-Reviewer-Id

# ============================================================
# HTTP API role keys（生产环境必填；四个值必须不同）
# ============================================================
MAILAGENT_SUBMITTER_API_KEY=
MAILAGENT_REVIEWER_API_KEY=
MAILAGENT_OPERATOR_API_KEY=
MAILAGENT_ADMIN_API_KEY=

# Vertical-specific configuration is declared by each installed plugin; see
# the generic vertical_overrides section in config.example.yml.

# ============================================================
# IMAP Mail Gateway（可选入站邮件轮询，mail-gateway-imap）
# 在 config.yml 设置 mail_gateway.enabled: true 后必填
# ============================================================

# IMAP 邮箱密码（不要写入 YAML，仅在环境变量中设置）
MAILAGENT_IMAP_PASSWORD=

# 以下变量可覆盖 config.yml 中的 mail_gateway.* 字段，便于不同环境部署
# MAILAGENT_MAIL_GATEWAY__ENABLED=true
# MAILAGENT_MAIL_GATEWAY__HOST=imap.your-provider.com
# MAILAGENT_MAIL_GATEWAY__USERNAME=ops@your-domain.com
# MAILAGENT_MAIL_GATEWAY__MAILBOX=INBOX
# MAILAGENT_MAIL_GATEWAY__INITIAL_SYNC_MODE=from_now
